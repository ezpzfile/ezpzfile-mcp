+/// EZPZ File: wait for the fonts the host page started fetching (`window.vectorFonts`: a Promise
+/// of `[{ family, bytes: Uint8Array }]`) and add them to the font database. The UI draws the
+/// characters its own fonts lack in them (Korean, Japanese, Chinese…) and type can use them.
+/// Without them (or on any error) the app starts without.
+async fn load_host_fonts() {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(value) = js_sys::Reflect::get(&window, &"vectorFonts".into()) else { return };
+    let Ok(promise) = value.dyn_into::<js_sys::Promise>() else { return };
+    let Ok(list) = wasm_bindgen_futures::JsFuture::from(promise).await else { return };
+    let Ok(list) = list.dyn_into::<js_sys::Array>() else { return };
+    for item in list.iter() {
+        let Some(bytes) = js_sys::Reflect::get(&item, &"bytes".into()).ok().and_then(|v| v.dyn_into::<js_sys::Uint8Array>().ok()) else { continue };
+        vectorcraft_text::FontDb::global().add_font(bytes.to_vec());
+    }
+}
