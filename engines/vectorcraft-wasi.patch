+/// EZPZ File: the host page opens files with `window.vectorOpen(name, Uint8Array)` and a new
+/// document with `window.vectorNew()`, and learns that the editor runs from
+/// `window.vectorOnReady()` (and of saves from `window.vectorOnSave(name)`, see [`download`]).
+fn expose_host_api(inbox: Inbox, ctx: egui::Context) -> Arc<std::sync::atomic::AtomicBool> {
+    use wasm_bindgen::closure::Closure;
+    let flag = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let Some(window) = web_sys::window() else { return flag };
+    let open_ctx = ctx.clone();
+    let open = Closure::<dyn Fn(String, js_sys::Uint8Array)>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes.to_vec()));
+        open_ctx.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"vectorOpen".into(), open.as_ref()).is_ok() {
+        open.forget();
+    }
+    let set = flag.clone();
+    let new = Closure::<dyn Fn()>::new(move || {
+        set.store(true, std::sync::atomic::Ordering::Relaxed);
+        ctx.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"vectorNew".into(), new.as_ref()).is_ok() {
+        new.forget();
+    }
+    call_host("vectorOnReady", None);
+    flag
+}
