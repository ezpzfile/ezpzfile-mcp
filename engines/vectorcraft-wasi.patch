+fn call_host_opened(name: &str, bytes: usize) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &"vectorOnOpen".into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let _ = f.call2(&window, &name.into(), &(bytes as f64).into());
+}
+
+/// EZPZ File: `window.vectorOnFeature(name, detail?)`.
+fn call_host_feature(name: &str, detail: Option<&str>) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &"vectorOnFeature".into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let detail = detail.map(wasm_bindgen::JsValue::from).unwrap_or(wasm_bindgen::JsValue::UNDEFINED);
+    let _ = f.call2(&window, &name.into(), &detail);
+}
