+/// EZPZ File: fonts after start. `window.vectorAddFont(bytes, rerender, requested)` adds one to the font database (type
+/// that names it redraws in it), `window.vectorSetFonts([{ family, label, local }])` lists the
+/// fonts the font menu offers to fetch (Google Fonts, this computer's fonts). Picking one calls
+/// `window.vectorWantFont(family)`; the menu's "this computer" row calls `window.vectorWantLocalFonts()`.
+fn expose_font_api(ctx: egui::Context) {
+    use vectorcraft_ui_egui::font_menu::{FONT_REQUEST, LOCAL_REQUEST, OnlineFont, set_online_fonts};
+    use wasm_bindgen::closure::Closure;
+    let Some(window) = web_sys::window() else { return };
+    let _ = FONT_REQUEST.set(request_font);
+    let _ = LOCAL_REQUEST.set(request_local_fonts);
+    let c = ctx.clone();
+    // (bytes, _rerender, requested?) → the families of the file. A file whose family differs from
+    // the name it was picked by (Google's "Nanum Pen Script" is "Nanum Pen") also answers to that name.
+    let add = Closure::<dyn Fn(js_sys::Uint8Array, wasm_bindgen::JsValue, wasm_bindgen::JsValue) -> js_sys::Array>::new(
+        move |bytes: js_sys::Uint8Array, _rerender: wasm_bindgen::JsValue, requested: wasm_bindgen::JsValue| {
+            let db = vectorcraft_text::FontDb::global();
+            let names = db.add_font_families(bytes.to_vec());
+            if let (Some(want), Some(first)) = (requested.as_string(), names.first())
+                && !names.iter().any(|n| n.eq_ignore_ascii_case(&want))
+            {
+                db.add_alias(&want, first);
+            }
+            c.request_repaint();
+            let out = js_sys::Array::new();
+            for n in &names {
+                out.push(&n.as_str().into());
+            }
+            out
+        },
+    );
+    if js_sys::Reflect::set(&window, &"vectorAddFont".into(), add.as_ref()).is_ok() {
+        add.forget();
+    }
+    let set = Closure::<dyn Fn(js_sys::Array)>::new(move |list: js_sys::Array| {
+        let get = |o: &wasm_bindgen::JsValue, k: &str| js_sys::Reflect::get(o, &k.into()).ok();
+        let fonts: Vec<OnlineFont> = list
+            .iter()
+            .filter_map(|o| {
+                let family = get(&o, "family")?.as_string()?;
+                let label = get(&o, "label").and_then(|v| v.as_string()).unwrap_or_else(|| family.clone());
+                let local = get(&o, "local").and_then(|v| v.as_bool()).unwrap_or(false);
+                Some(OnlineFont { family, label, local })
+            })
+            .collect();
+        set_online_fonts(fonts);
+        ctx.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"vectorSetFonts".into(), set.as_ref()).is_ok() {
+        set.forget();
+    }
+}
