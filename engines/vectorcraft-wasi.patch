+/// Call `window.<name>(value)` if the host page defined it.
+fn call_host_value(name: &str, value: &wasm_bindgen::JsValue) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &name.into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let _ = f.call1(&window, value);
+}
