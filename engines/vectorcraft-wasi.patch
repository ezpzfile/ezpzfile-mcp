+/// What the single-key shortcuts read: the text typed, by the key's place on the keyboard when the
+/// layout types something else. With a Korean (or other non-Latin) input mode on, P types `ㅔ` and
+/// the shortcut would never match (EZPZ File, 2026-11-04): such text takes its key's letter, and a
+/// key that typed no text at all (an IME holding it, `Process`) counts as its letter too.
+fn single_key_texts(events: &[egui::Event], m: Modifiers) -> Vec<(String, Modifiers)> {
+    let letter = |k: &Key| {
+        let n = k.name();
+        (n.len() == 1 && n.chars().all(|c| c.is_ascii_alphanumeric())).then(|| n.to_ascii_lowercase())
+    };
+    let mut physical = events.iter().filter_map(|e| match e {
+        egui::Event::Key { physical_key: Some(p), pressed: true, modifiers, .. } if !(modifiers.command || modifiers.alt || modifiers.ctrl) => {
+            letter(p)
+        }
+        _ => None,
+    });
+    let texts: Vec<(String, Modifiers)> = events
+        .iter()
+        .filter_map(|e| match e {
+            egui::Event::Text(t) if t.is_ascii() => Some((t.clone(), m)),
+            egui::Event::Text(t) => Some((physical.next().unwrap_or_else(|| t.clone()), m)),
+            _ => None,
+        })
+        .collect();
+    if !texts.is_empty() {
+        return texts;
+    }
+    // No text: keys a non-Latin input method kept to itself still name their letter.
+    events
+        .iter()
+        .filter_map(|e| match e {
+            egui::Event::Key { key, physical_key: Some(p), pressed: true, repeat: false, modifiers }
+                if key == p && !(modifiers.command || modifiers.alt || modifiers.ctrl) && letter(p).is_some() =>
+            {
+                letter(p).map(|l| (l, *modifiers))
+            }
+            _ => None,
+        })
+        .collect()
+}
