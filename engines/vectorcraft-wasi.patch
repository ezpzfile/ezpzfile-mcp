+/// EZPZ File: the name this modified build goes by. VectorCraft's brand licence asks modified
+/// versions not to present themselves as the ArtCraft product, so the UI says "Vector Editor"
+/// wherever a string names the app (the About box still says it is based on VectorCraft).
+pub const APP_NAME: &str = "Vector Editor";
+
+/// `s` with the app's name replaced by [`APP_NAME`] (each distinct string is made once and kept).
+pub fn brand(s: &str) -> &str {
+    // The credit line and the licence line name VectorCraft itself and stay as they are.
+    if !s.contains("VectorCraft") || s.contains("ArtCraft") || s.contains("Lucide") {
+        return s;
+    }
+    static MADE: std::sync::Mutex<Option<std::collections::HashMap<String, &'static str>>> = std::sync::Mutex::new(None);
+    let mut made = MADE.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let map = made.get_or_insert_with(std::collections::HashMap::new);
+    if let Some(v) = map.get(s) {
+        return v;
+    }
+    let v: &'static str = Box::leak(s.replace("VectorCraft", APP_NAME).into_boxed_str());
+    map.insert(s.to_string(), v);
+    v
 }
 
