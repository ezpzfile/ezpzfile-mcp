+/// `window.photocraftNew()`: the host page's "New document" button.
+fn expose_new_doc(ctx: egui::Context) -> Arc<std::sync::atomic::AtomicBool> {
+    use wasm_bindgen::closure::Closure;
+    let flag = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let Some(window) = web_sys::window() else { return flag };
+    let set = flag.clone();
+    let f = Closure::<dyn Fn()>::new(move || {
+        set.store(true, std::sync::atomic::Ordering::Relaxed);
+        ctx.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"photocraftNew".into(), f.as_ref()).is_ok() {
+        f.forget();
+    }
+    flag
+}
