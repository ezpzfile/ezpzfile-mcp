+/// Call `window.<name>(value)` if the host page defined it.
+fn call_host_value(name: &str, value: &wasm_bindgen::JsValue) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &name.into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let _ = f.call1(&window, value);
+}
+
+/// `window.photocraftOnOpen(name, bytes)`: a file opened from the editor's own File › Open or
+/// dropped on its canvas (files the host page hands in, it already knows of).
+fn call_host_opened(name: &str, bytes: usize) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &"photocraftOnOpen".into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let _ = f.call2(&window, &name.into(), &(bytes as f64).into());
+}
+
+/// Call `window.<name>(arg)` if the host page defined it.
+fn call_host(name: &str, arg: Option<&str>) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(f) = js_sys::Reflect::get(&window, &name.into()) else { return };
+    let Ok(f) = f.dyn_into::<js_sys::Function>() else { return };
+    let _ = match arg {
+        Some(a) => f.call1(&window, &a.into()),
+        None => f.call0(&window),
+    };
+}
