+/// EZPZ File: the host page opens files with `window.photocraftOpen(name, Uint8Array)` and learns
+/// that the editor runs from `window.photocraftOnReady()` (and of saves from
+/// `window.photocraftOnSave(name)`, see [`download`]).
+fn expose_host_api(inbox: Inbox, ctx: egui::Context) {
+    use wasm_bindgen::closure::Closure;
+    let Some(window) = web_sys::window() else { return };
+    let open = Closure::<dyn Fn(String, js_sys::Uint8Array)>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes.to_vec()));
+        ctx.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"photocraftOpen".into(), open.as_ref()).is_ok() {
+        open.forget();
+    }
+    call_host("photocraftOnReady", None);
+}
