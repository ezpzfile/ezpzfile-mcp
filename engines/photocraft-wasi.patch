+/// Wait for the fonts the host page started fetching (`window.photocraftFonts`: a Promise of
+/// `[{ script: "ko" | "ja" | "zh-hans" | "zh-hant", family, bytes: Uint8Array }]`) and register them
+/// as the UI's CJK fallback. Without it (or on any error) the UI starts without them.
+async fn load_host_fonts() {
+    use photocraft_text::cjk::CjkScript;
+    let Some(window) = web_sys::window() else { return };
+    let Ok(value) = js_sys::Reflect::get(&window, &"photocraftFonts".into()) else { return };
+    let Ok(promise) = value.dyn_into::<js_sys::Promise>() else { return };
+    let Ok(list) = wasm_bindgen_futures::JsFuture::from(promise).await else { return };
+    let Ok(list) = list.dyn_into::<js_sys::Array>() else { return };
+    for item in list.iter() {
+        let get = |k: &str| js_sys::Reflect::get(&item, &k.into()).ok();
+        let script = match get("script").and_then(|v| v.as_string()).as_deref() {
+            Some("ko") => Some(CjkScript::Korean),
+            Some("ja") => Some(CjkScript::Japanese),
+            Some("zh-hans") => Some(CjkScript::SimplifiedChinese),
+            Some("zh-hant") => Some(CjkScript::TraditionalChinese),
+            // Other scripts (Thai, Devanagari): a plain fallback for the UI and the type layers.
+            Some("other") => None,
+            _ => continue,
+        };
+        let family: &'static str = Box::leak(get("family").and_then(|v| v.as_string()).unwrap_or_else(|| "host".into()).into_boxed_str());
+        let Some(bytes) = get("bytes").and_then(|v| v.dyn_into::<js_sys::Uint8Array>().ok()) else { continue };
+        // One copy for the session, shared by the UI and the document text engine (type layers).
+        let bytes: &'static [u8] = Box::leak(bytes.to_vec().into_boxed_slice());
+        match script {
+            Some(script) => photocraft_ui_egui::cjk_fonts::add_web_font(script, family, bytes),
+            None => photocraft_ui_egui::cjk_fonts::add_extra_web_font(family, bytes),
+        }
+        photocraft_text::fonts::add_host_font(bytes);
+    }
+}
