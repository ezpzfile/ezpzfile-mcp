+/// EZPZ File: fonts the host page fetched after start (`window.photocraftAddFont(bytes, rerender,
+/// requested)`), acted on in the next frame. `rerender`: re-render the type layers that use them (a font
+/// someone just picked); fonts fetched for a just-opened file leave its pixels as they are.
+static PENDING_FONTS: Mutex<Vec<FontArrival>> = Mutex::new(Vec::new());
+
+/// A font registered by `photocraftAddFont`, for the next frame to act on.
+struct FontArrival {
+    /// The families the file's faces belong to.
+    names: Vec<String>,
+    rerender: bool,
+    /// The name it was picked by, when that differs from `names` (type is moved to `names[0]`).
+    requested: Option<String>,
+}
+
+fn request_font(name: &str) {
+    call_host("photocraftWantFont", Some(name));
+}
+fn request_local_fonts() {
+    call_host("photocraftWantLocalFonts", None);
+}
+
+/// `window.photocraftAddFont(bytes, rerender)` and `window.photocraftSetFonts([{ family, label, local }])`
+/// (the fonts the pickers offer to fetch: Google Fonts, this computer's fonts). Picking one calls
+/// `window.photocraftWantFont(family)`; the pickers' "this computer" button calls
+/// `window.photocraftWantLocalFonts()`.
+fn expose_font_api(ctx: egui::Context) {
+    use photocraft_ui_egui::type_tool::{FONT_REQUEST, LOCAL_REQUEST, OnlineFont, set_online_fonts};
+    use wasm_bindgen::closure::Closure;
+    let Some(window) = web_sys::window() else { return };
+    let _ = FONT_REQUEST.set(request_font);
+    let _ = LOCAL_REQUEST.set(request_local_fonts);
+    let c = ctx.clone();
+    // (bytes, rerender, requested?) → the families of the file, registered at once (the lists
+    // show it next frame; type re-renders then).
+    let add = Closure::<dyn Fn(js_sys::Uint8Array, wasm_bindgen::JsValue, wasm_bindgen::JsValue) -> js_sys::Array>::new(
+        move |bytes: js_sys::Uint8Array, rerender: wasm_bindgen::JsValue, requested: wasm_bindgen::JsValue| {
+            let names = photocraft_text::shared().lock().unwrap_or_else(|e| e.into_inner()).fonts.register_font_data(bytes.to_vec());
+            photocraft_ui_egui::type_tool::fonts_changed();
+            let requested = requested.as_string().filter(|r| !names.iter().any(|n| n.eq_ignore_ascii_case(r)));
+            let out = js_sys::Array::new();
+            for n in &names {
+                out.push(&n.as_str().into());
+            }
+            PENDING_FONTS.lock().unwrap_or_else(|e| e.into_inner()).push(FontArrival { names, rerender: rerender.as_bool().unwrap_or(true), requested });
+            c.request_repaint();
+            out
+        },
+    );
+    if js_sys::Reflect::set(&window, &"photocraftAddFont".into(), add.as_ref()).is_ok() {
+        add.forget();
+    }
+    let c = ctx.clone();
+    let set = Closure::<dyn Fn(js_sys::Array)>::new(move |list: js_sys::Array| {
+        let get = |o: &wasm_bindgen::JsValue, k: &str| js_sys::Reflect::get(o, &k.into()).ok();
+        let fonts: Vec<OnlineFont> = list
+            .iter()
+            .filter_map(|o| {
+                let family = get(&o, "family")?.as_string()?;
+                let label = get(&o, "label").and_then(|v| v.as_string()).unwrap_or_else(|| family.clone());
+                let local = get(&o, "local").and_then(|v| v.as_bool()).unwrap_or(false);
+                Some(OnlineFont { family, label, local })
+            })
+            .collect();
+        set_online_fonts(fonts);
+        c.request_repaint();
+    });
+    if js_sys::Reflect::set(&window, &"photocraftSetFonts".into(), set.as_ref()).is_ok() {
+        set.forget();
+    }
+}
