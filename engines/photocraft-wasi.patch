+        }
+        self.reported = Some(state);
+        let set = |o: &js_sys::Object, k: &str, v: wasm_bindgen::JsValue| {
+            let _ = js_sys::Reflect::set(o, &k.into(), &v);
+        };
+        let o = js_sys::Object::new();
+        set(&o, "shown", state.shown.into());
+        set(&o, "covered", state.covered.into());
+        set(&o, "docs", (state.docs as u32).into());
+        set(&o, "dirty", state.dirty.into());
+        if let Some([x, y, w, h]) = state.rect {
+            let r = js_sys::Object::new();
+            set(&r, "x", x.into());
+            set(&r, "y", y.into());
+            set(&r, "w", w.into());
+            set(&r, "h", h.into());
+            set(&o, "rect", r.into());
+        }
+        call_host_value("photocraftOnState", &o.into());
+    }
