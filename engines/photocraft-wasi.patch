+/// Bumped when fonts are added at run time (EZPZ File web build), so [`families`] re-reads.
+static FAMILY_GEN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// EZPZ File: fonts were registered after start; the family lists re-read the font database.
+pub fn fonts_changed() {
+    FAMILY_GEN.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Font families (bundled + system), cached until [`fonts_changed`].
+pub fn families() -> std::sync::Arc<Vec<String>> {
+    static FAMILIES: std::sync::Mutex<Option<(u64, std::sync::Arc<Vec<String>>)>> = std::sync::Mutex::new(None);
+    let gen_now = FAMILY_GEN.load(std::sync::atomic::Ordering::Relaxed);
+    let mut g = FAMILIES.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((gen_had, list)) = g.as_ref()
+        && *gen_had == gen_now
+    {
+        return list.clone();
+    }
+    let list = std::sync::Arc::new(photocraft_text::shared().lock().map(|mut e| e.fonts.families()).unwrap_or_default());
+    *g = Some((gen_now, list.clone()));
+    list
+}
+
+/// EZPZ File web build: a font the host page can fetch when it is picked (Google Fonts, or one
+/// installed on this computer). `label` is what the list shows (a Korean / Japanese name).
+#[derive(Clone)]
+pub struct OnlineFont {
+    pub family: String,
+    pub label: String,
+    pub local: bool,
+}
+
+static ONLINE: std::sync::Mutex<Vec<OnlineFont>> = std::sync::Mutex::new(Vec::new());
+/// Asks the host page to fetch a picked online font (it then registers it and re-renders).
+pub static FONT_REQUEST: std::sync::OnceLock<fn(&str)> = std::sync::OnceLock::new();
+/// Asks the host page to list this computer's fonts (it then adds them with [`set_online_fonts`]).
+pub static LOCAL_REQUEST: std::sync::OnceLock<fn()> = std::sync::OnceLock::new();
+
+/// Replace the fetchable fonts the pickers list below the installed ones.
+pub fn set_online_fonts(list: Vec<OnlineFont>) {
+    *ONLINE.lock().unwrap_or_else(|e| e.into_inner()) = list;
+}
+
+/// The family rows of a font picker: installed families, then (web) the fonts the host page can
+/// fetch on pick, with a button that lists this computer's fonts. Returns the picked family.
+pub fn family_rows(ui: &mut egui::Ui, ql: &str, current: &str) -> Option<String> {
+    let mut picked = None;
+    let have = families();
+    for f in have.iter().filter(|f| ql.is_empty() || f.to_lowercase().contains(ql)) {
+        if ui.selectable_label(f == current, f).clicked() {
+            picked = Some(f.clone());
+        }
+    }
+    let online = ONLINE.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    let request = FONT_REQUEST.get().copied();
+    if request.is_none() {
+        return picked;
+    }
+    let have_lc: std::collections::HashSet<String> = have.iter().map(|f| f.to_lowercase()).collect();
+    let matches = |o: &OnlineFont| {
+        !have_lc.contains(&o.family.to_lowercase()) && (ql.is_empty() || o.family.to_lowercase().contains(ql) || o.label.to_lowercase().contains(ql))
+    };
+    let t = crate::theme::Tokens::get(ui.ctx());
+    for local in [true, false] {
+        let rows: Vec<&OnlineFont> = online.iter().filter(|o| o.local == local && matches(o)).collect();
+        if local && rows.is_empty() {
+            if online.iter().all(|o| !o.local)
+                && let Some(ask) = LOCAL_REQUEST.get()
+            {
+                ui.separator();
+                if ui.button(tl!("Show this computer's fonts")).clicked() {
+                    ask();
+                }
+            }
+            continue;
+        }
+        if rows.is_empty() {
+            continue;
+        }
+        ui.separator();
+        ui.label(egui::RichText::new(if local { tl!("This computer's fonts") } else { tl!("Online fonts (downloaded when picked)") }).size(11.0).color(t.text_dim));
+        for o in rows {
+            let text = if o.label != o.family { format!("{}  ({})", o.label, o.family) } else { o.family.clone() };
+            if ui.selectable_label(o.family == current, text).clicked() {
+                if let Some(r) = request {
+                    r(&o.family);
+                }
+                picked = Some(o.family.clone());
+            }
+        }
+    }
+    picked
 }
 
