+/// The host page's language as a PhotoCraft code: `?lang=` first, then `<html lang>`. Codes the
+/// site uses that differ from PhotoCraft's are mapped (zh → zh-hans, zh-tw → zh-hant,
+/// pt → pt-br); anything without a catalog falls back to English.
+fn host_lang(q: &str, document: &web_sys::Document) -> String {
+    let from_query = q.trim_start_matches('?').split('&').find_map(|kv| kv.strip_prefix("lang=")).map(str::to_string);
+    let tag = from_query.or_else(|| document.document_element().and_then(|e| e.get_attribute("lang"))).unwrap_or_default().to_ascii_lowercase();
+    match tag.as_str() {
+        "zh" | "zh-cn" | "zh-hans" => "zh-hans".into(),
+        "zh-tw" | "zh-hk" | "zh-hant" => "zh-hant".into(),
+        "pt" | "pt-br" => "pt-br".into(),
+        _ => tag,
+    }
+}
