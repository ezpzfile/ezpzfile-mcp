+            [(r.min.x * z).round() as i32, (r.min.y * z).round() as i32, (r.width() * z).round() as i32, (r.height() * z).round() as i32]
+        });
+        let state = HostState {
+            shown: docs.is_empty(),
+            covered: !self.app.ui.dialogs.is_empty() || self.app.ui.palette_open || egui::Popup::is_any_open(ctx),
+            rect,
+            docs: docs.len(),
+            dirty: docs.iter().any(|d| d.is_dirty()),
+        };
